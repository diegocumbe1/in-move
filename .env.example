# ---- Supabase (capa gratuita) ----
# Copia este archivo a .env.local y rellena los valores desde tu proyecto Supabase:
#   Supabase Dashboard -> Settings -> API

# Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Settings -> API -> Project API keys -> "anon" / "public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...tu-anon-key

# NOTA: no agregues aqui la service_role key.
# Esa clave nunca debe llegar al navegador.

# ---- Postgres / Drizzle ORM ----
# Supabase Dashboard -> Settings -> Database -> Connection string
# Reemplaza [PASSWORD] por la contraseña de la base (Settings -> Database -> Reset password si no la recuerdas).

# Runtime en Vercel/serverless: usa el "Transaction pooler" (puerto 6543).
DATABASE_URL=postgresql://postgres.ucyswhtgbsdlpobzaptg:[PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres

# Solo para drizzle-kit push/migraciones: usa "Session pooler"/directa (puerto 5432).
DIRECT_URL=postgresql://postgres.ucyswhtgbsdlpobzaptg:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
